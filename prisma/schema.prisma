generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  OPERADOR
}

enum StatusPedido {
  PENDENTE
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  TRANSFERENCIA
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
}

model Tenant {
  id        String    @id @default(cuid())
  nome      String
  slug      String    @unique
  ativo     Boolean   @default(true)
  criadoEm  DateTime  @default(now())
  usuarios  Usuario[]
  produtos  Produto[]
  clientes  Cliente[]
  pedidos   Pedido[]
  vendas    Venda[]
  despesas  Despesa[]
  movimentosEstoque MovimentoEstoque[]
}

model Usuario {
  id           String   @id @default(cuid())
  tenantId     String
  nome         String
  email        String
  senhaHash    String
  papel        Papel    @default(OPERADOR)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Produto {
  id             String   @id @default(cuid())
  tenantId       String
  nome           String
  descricao      String?
  categoria      String?
  unidade        String   @default("UN")
  precoVenda     Decimal  @db.Decimal(12, 2)
  custoUnitario  Decimal  @default(0) @db.Decimal(12, 2)
  estoque        Decimal  @default(0) @db.Decimal(12, 3)
  estoqueMinimo  Decimal  @default(0) @db.Decimal(12, 3)
  fotoUrl        String?
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itensPedido    ItemPedido[]
  itensVenda     ItemVenda[]
  movimentos     MovimentoEstoque[]

  @@index([tenantId, nome])
}

model Cliente {
  id        String   @id @default(cuid())
  tenantId  String
  nome      String
  telefone  String?
  email     String?
  endereco  String?
  criadoEm  DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedidos   Pedido[]
  vendas    Venda[]

  @@index([tenantId, nome])
}

model Pedido {
  id              String       @id @default(cuid())
  tenantId        String
  clienteId       String?
  clienteNome     String?
  telefone        String?
  observacao      String?
  status          StatusPedido @default(PENDENTE)
  dataEntrega     DateTime?
  subtotal        Decimal      @db.Decimal(12, 2)
  desconto        Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  formaPagamento  FormaPagamento?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente         Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  itens           ItemPedido[]
  historico       HistoricoPedido[]

  @@index([tenantId, status, criadoEm])
}

model ItemPedido {
  id             String  @id @default(cuid())
  pedidoId       String
  produtoId      String?
  descricao      String
  quantidade     Decimal @db.Decimal(12, 3)
  precoUnitario  Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  pedido         Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto        Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
}

model HistoricoPedido {
  id         String       @id @default(cuid())
  pedidoId   String
  status     StatusPedido
  observacao String?
  criadoEm   DateTime     @default(now())
  pedido     Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, criadoEm])
}

model MovimentoEstoque {
  id          String                @id @default(cuid())
  tenantId    String
  produtoId   String
  tipo        TipoMovimentoEstoque
  quantidade  Decimal               @db.Decimal(12, 3)
  motivo      String?
  criadoEm    DateTime              @default(now())
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produto     Produto               @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([tenantId, criadoEm])
}

model Venda {
  id             String          @id @default(cuid())
  tenantId       String
  clienteId      String?
  subtotal       Decimal         @db.Decimal(12, 2)
  desconto       Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  formaPagamento FormaPagamento
  recebido       Boolean         @default(true)
  criadoEm       DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente        Cliente?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  itens          ItemVenda[]

  @@index([tenantId, criadoEm])
}

model ItemVenda {
  id             String  @id @default(cuid())
  vendaId        String
  produtoId      String?
  descricao      String
  quantidade     Decimal @db.Decimal(12, 3)
  precoUnitario  Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  venda          Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto        Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
}

model Despesa {
  id          String   @id @default(cuid())
  tenantId    String
  descricao   String
  categoria   String?
  valor       Decimal  @db.Decimal(12, 2)
  data        DateTime @default(now())
  observacao  String?
  criadoEm    DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, data])
}
